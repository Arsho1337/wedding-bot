# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Your own numeric Telegram id (send /id to any userinfo bot, or after first run)
# Comma separated, more than one leader allowed:
ADMIN_IDS=123456789

# Where SQLite lives. Relative paths resolve next to bot.py.
DB_PATH=data/bot.db

# Timezone used for timestamps and "updated at"
TZ_NAME=Asia/Tehran

# Proxy (optional): "socks5://user:pass@host:port" or "http://host:port"
# Set this if Telegram is blocked in your region (e.g., Iran)
# PROXY_URL=socks5://user:pass@host:port
